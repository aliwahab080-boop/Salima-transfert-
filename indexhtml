<!DOCTYPE html><html lang="fr"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>SALIMA V27 NIGER BUGFIX</title>
<script src="https://sdk.minepi.com/pi-sdk.js"></script>
<style>
*{box-sizing:border-box;margin:0}body{background:#000;color:#fff;font-family:system-ui;padding-bottom:20px}
.h{background:linear-gradient(135deg,#7ab800,#5a8a00);color:#000;padding:16px;position:sticky;top:0;z-index:30}
.s{font-size:32px;font-weight:900;display:flex;align-items:center;gap:10px}
.eye{background:#000;color:#7ab800;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;cursor:pointer}
.pill{background:rgba(0,0,0,.2);padding:5px 10px;border-radius:20px;font-size:11px;font-weight:800;margin:2px;display:inline-block}
.pill.pi{background:#000;color:#7aff7a;border:1px solid #7aff7a}
.card{background:#111;border:1px solid #222;border-radius:20px;margin:10px;padding:14px}
.g{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.b{background:#1a1a1a;border:1px solid #333;border-radius:16px;padding:16px;text-align:center;font-weight:700;cursor:pointer}
.b:active{transform:scale(.96);background:#222}.b.green{border-color:#7ab800;color:#7ab800}
.btn{width:100%;background:#7ab800;border:0;padding:14px;border-radius:12px;font-weight:900;color:#000;margin-top:8px}
.btnPi{background:#6f00ff;color:#fff}.btn2{background:#222;color:#fff;border:1px solid #444;padding:11px;border-radius:10px;width:100%;margin-top:7px}
.tabs{display:flex;gap:6px;margin-bottom:10px}.tab{flex:1;padding:10px;border-radius:10px;text-align:center;background:#1a1a1a;border:1px solid #333;font-weight:800;font-size:12px}.tab.on{background:#7ab800;color:#000}
select,input{width:100%;padding:12px;border-radius:10px;border:1px solid #333;background:#000;color:#fff;margin:5px 0}
#modal{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:100;display:none;align-items:center;justify-content:center;padding:12px}
#modal.on{display:flex}.m{background:#121212;border:1px solid #444;border-radius:18px;padding:16px;width:100%;max-width:400px;max-height:92vh;overflow:auto}
#receiptView{display:none;position:fixed;inset:0;background:#000;z-index:300;padding:10px;overflow:auto}
#receiptView.on{display:block}.wrap{max-width:420px;margin:0 auto;background:#0a1f0a;border:2px solid #1a4a1a;border-radius:22px;padding:10px}
.topOk{background:#c8f5c8;color:#0a3a0a;border-radius:14px;padding:12px;display:flex;gap:10px;align-items:center}
.row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #222;font-size:13px}.row span:last-child{font-weight:700;color:#fff;text-align:right}
.totalRow{display:flex;justify-content:space-between;padding:12px 0;font-weight:900}.totalRow span:last-child{color:#4ade80;font-size:20px}
</style>
</head><body>
<div class="h">
<small style="font-weight:800;opacity:.7">SOLDE DISPONIBLE</small>
<div class="s"><span id="soldeTxt">250 000 FCFA</span><span class="eye" onclick="toggleSolde()" id="eyeBtn">👁️</span></div>
<div style="margin-top:6px"><span class="pill pi" id="piStatus">● Pi: Prêt</span><span class="pill" id="locPill">📍 Niamey - Gamkalley</span><span class="pill" id="nbT">0 transac</span><span class="pill" style="background:#000;color:#7ab800" id="revPill">0 F bénéf</span></div>
</div>

<div class="card">
<div class="tabs"><div class="tab on" id="tabW" onclick="switchTab('wallet')">🏠 Wallet</div><div class="tab" id="tabP" onclick="switchTab('pays')">🌍 Pays & Villages</div><div class="tab" id="tabR" onclick="switchTab('profil')">👤 Profil Pi</div></div>

<div id="viewWallet">
<div style="background:#0f1a00;border:1px solid #2a4a00;border-radius:10px;padding:8px;font-size:11px">🔄 <b>Interop:</b> Salima ↔ NITA ↔ Amana ↔ Airtel ↔ Moov ↔ Zamani | ⚡ NIGELEC | 💧 SEEN (Eau)</div>
<div class="g">
<div class="b" onclick="openS('Salima')">Salima<br><small>→ NITA/Amana</small></div>
<div class="b" onclick="openS('NITA')">NITA<br><small>→ Salima/Amana</small></div>
<div class="b" onclick="openS('Amana')">Amana<br><small>→ Salima/NITA</small></div>
<div class="b" onclick="openS('Airtel Money')">Airtel Money</div>
<div class="b" onclick="openS('Moov Money')">Moov Money</div>
<div class="b" onclick="openS('Zamani')">Zamani</div>
<div class="b" onclick="openS('NIGELEC')">NIGELEC<br><small>⚡ Élec</small></div>
<div class="b" onclick="openS('SEEN')">SEEN<br><small>💧 Eau</small></div>
<div class="b" onclick="openS('Canal+')">Canal+</div>
<div class="b green" onclick="openS('Encaisser')">Encaisser +</div>
</div>
<div style="margin-top:12px"><b>Derniers reçus (jamais effacés)</b><div id="list" style="margin-top:8px"></div></div>
</div>

<div id="viewPays" style="display:none">
<h3>🌍 Niger - Pays & Villages</h3>
<label>Pays</label><select id="paysSel"><option value="NE">🇳🇪 Niger</option><option value="BJ">🇧🇯 Bénin</option><option value="BF">🇧🇫 Burkina</option><option value="ML">🇲🇱 Mali</option><option value="NG">🇳🇬 Nigeria</option><option value="TG">🇹🇬 Togo</option><option value="SN">🇸🇳 Sénégal</option><option value="CI">🇨🇮 CI</option></select>
<label>Région</label><select id="regionSel" onchange="updateDepts()"></select>
<label>Département</label><select id="deptSel" onchange="updateVillages()"></select>
<label>Village / Quartier</label><select id="villageSel" onchange="saveLoc()"></select>
<input id="villageManual" placeholder="Ou tape village: ex: Gamkalley, Yantala..." oninput="saveLocManual()">
<div style="background:#111;border-radius:10px;padding:8px;margin-top:8px;font-size:12px" id="locInfo"></div>
<button class="btn" onclick="saveLoc();switchTab('wallet')">✓ Valider</button>
</div>

<div id="viewProfil" style="display:none">
<h3>👤 Profil & Pi SDK</h3>
<div style="background:#1a0a3a;border:1px solid #6f00ff;border-radius:14px;padding:12px;margin:8px 0"><div id="piDetail" style="font-size:12px">Pi non connecté - Ouvre dans Pi Browser</div><button class="btn btnPi" id="btnPi" onclick="connectPi()">🔗 CONNECTER PI WALLET</button></div>
<label>Nom</label><input id="profName" placeholder="Ali Wahab"><label>Tél</label><input id="profPhone" placeholder="+227..."><label>Village</label><input id="profVillage" placeholder="Gamkalley"><button class="btn" onclick="saveProfile()">💾 Sauver</button>
</div>
</div>

<div id="modal"><div class="m">
<div style="display:flex;justify-content:space-between"><b id="mTitle">Service</b><b onclick="closeM()" style="cursor:pointer">✕</b></div>
<div id="mDesc" style="font-size:11px;opacity:.6;margin:6px 0"></div>
<label>📍 Village</label><select id="mVillageSel"></select>
<label id="labelNum">Numéro / Référence</label><input id="num" type="text" placeholder="90 12 34 56">
<div id="fieldInterop" style="display:none;background:#0f1a00;border-radius:8px;padding:8px;margin:6px 0;font-size:12px"><label>Envoyer vers</label><select id="interopSel"><option>Salima</option><option>NITA</option><option>Amana</option><option>Airtel Money</option><option>Moov Money</option><option>Zamani</option></select></div>
<div id="fieldFacture" style="display:none;background:#1a0a00;border-radius:8px;padding:8px;margin:6px 0"><label id="factureLabel">Réf compteur</label><input id="factureRef" placeholder="Réf NIGELEC / SEEN"><select id="factureType"><option>Facture mensuelle</option><option>Prépayé</option></select></div>
<label>Montant FCFA</label><input id="mont" type="number" placeholder="5000"><div id="calc" style="background:#0f1a00;border-radius:8px;padding:8px;margin:6px 0;font-size:12px"></div>
<div style="display:flex;gap:8px"><button class="btn" style="background:#333;color:#fff;flex:1" onclick="closeM()">Annuler</button><button class="btn" style="flex:1.5" onclick="doTrans()">VALIDER ✓</button></div>
<div style="font-size:10px;opacity:.4;text-align:center;margin-top:6px" id="piValidTag">Pi: - | Village: -</div>
</div></div>

<div id="receiptView"><div class="wrap"><div class="topOk"><div style="background:#158a15;color:#fff;width:36px;height:36px;border-radius:50%;display:grid;place-items:center">✓</div><div><b>Transaction réussie</b><br><small id="rSub">Validé</small></div></div><div style="background:#0f0f0f;border-radius:14px;padding:14px;margin-top:10px;font-size:13px;line-height:1.6" id="rDetail"></div><button style="width:100%;margin-top:10px;background:#7ab800;border:0;padding:12px;border-radius:10px;font-weight:800" onclick="document.getElementById('receiptView').classList.remove('on')">Done ✓</button></div></div>

<script>
const NIGER_DATA={
"Agadez":{depts:["Arlit","Bilma","Tchirozérine"],villages:["Agadez","Arlit","Timia","Iferouane","Ingall","Bilma"]},
"Diffa":{depts:["Diffa","N'Guigmi","Bosso"],villages:["Diffa","N'Guigmi","Bosso","Maine-Soroa"]},
"Dosso":{depts:["Dosso","Gaya","Dogondoutchi","Boboye"],villages:["Dosso","Gaya","Dogondoutchi","Boboye","Birni N'Gaouré","Loga"]},
"Maradi":{depts:["Madarounfa","Aguié","Dakoro","Tessaoua"],villages:["Maradi","Tessaoua","Dakoro","Aguié","Guidan Roumdji","Mayahi"]},
"Tahoua":{depts:["Tahoua","Konni","Madaoua","Bouza","Illéla"],villages:["Tahoua","Konni","Madaoua","Bouza","Illéla","Kéita","Abalak"]},
"Tillabéri":{depts:["Tillabéri","Kollo","Say","Téra","Ouallam"],villages:["Tillabéri","Kollo","Say","Téra","Ouallam","Filingue","Torodi"]},
"Zinder":{depts:["Zinder","Mirriah","Magaria","Tanout"],villages:["Zinder","Mirriah","Magaria","Tanout","Gouré","Matameye"]},
"Niamey":{depts:["Niamey I","Niamey II","Niamey III","Niamey IV","Niamey V"],villages:["Gamkalley","Yantala","Lazaret","Boukoki","Wadata","Talladjé","Koira Kano","Goudel","Lamordé","Saga","Niamey 2000","Harobanda","Kirkissoye","Gawèye","Pays Bas","Maourey","Terminus","Riyad","Aéroport","Koubia"]}
};
let solde=parseInt(localStorage.getItem('sal_v27_solde')||'250000');
let soldeVisible=localStorage.getItem('solde_visible')!=='no';
let piUser=null;let cur='';let lastRec=null;let piReady=false;
let currentLoc=JSON.parse(localStorage.getItem('currentLoc')||'{"pays":"NE","region":"Niamey","dept":"Niamey I","village":"Gamkalley"}');

function init(){
let rSel=document.getElementById('regionSel');rSel.innerHTML=Object.keys(NIGER_DATA).map(r=>`<option ${r===currentLoc.region?'selected':''}>${r}</option>`).join('');
updateDepts();initPiSdk();refresh();updateLocPill();
document.getElementById('profVillage').value=currentLoc.village;
document.getElementById('profName').value=localStorage.getItem('profName')||'';
document.getElementById('profPhone').value=localStorage.getItem('profPhone')||'';
}
function updateDepts(){
let region=document.getElementById('regionSel').value;
let dSel=document.getElementById('deptSel');
let depts=NIGER_DATA[region]?.depts||[];
dSel.innerHTML=depts.map(d=>`<option ${d===currentLoc.dept?'selected':''}>${d}</option>`).join('');
updateVillages();
}
function updateVillages(){
let region=document.getElementById('regionSel').value;
let villages=NIGER_DATA[region]?.villages||[];
let vSel=document.getElementById('villageSel');
vSel.innerHTML=villages.map(v=>`<option ${v===currentLoc.village?'selected':''}>${v}</option>`).join('');
document.getElementById('mVillageSel').innerHTML=villages.map(v=>`<option ${v===currentLoc.village?'selected':''}>${v}</option>`).join('');
saveLocPreview();
}
function saveLocPreview(){
let r=document.getElementById('regionSel').value;let d=document.getElementById('deptSel').value;let v=document.getElementById('villageSel').value||currentLoc.village;
document.getElementById('locInfo').innerHTML=`📍 <b>${r} - ${d} - ${v}</b><br><small>NIGELEC/SEEN dispo pour ${r}</small>`;
}
function saveLoc(){
let pays=document.getElementById('paysSel').value;let region=document.getElementById('regionSel').value;let dept=document.getElementById('deptSel').value;let village=document.getElementById('villageSel').value;
currentLoc={pays,region,dept,village};localStorage.setItem('currentLoc',JSON.stringify(currentLoc));updateLocPill();saveLocPreview();
document.getElementById('mVillageSel').innerHTML=`<option>${village}</option>`;
}
function saveLocManual(){
let v=document.getElementById('villageManual').value.trim();if(v){currentLoc.village=v;localStorage.setItem('currentLoc',JSON.stringify(currentLoc));updateLocPill();}
}
function updateLocPill(){document.getElementById('locPill').innerText=`📍 ${currentLoc.region} - ${currentLoc.village}`;document.getElementById('piValidTag').innerText=`Pi: ${piUser?piUser.username:'Non'} | Village: ${currentLoc.village}`;}
function switchTab(t){
document.getElementById('viewWallet').style.display=t==='wallet'?'block':'none';
document.getElementById('viewPays').style.display=t==='pays'?'block':'none';
document.getElementById('viewProfil').style.display=t==='profil'?'block':'none';
document.getElementById('tabW').classList.toggle('on',t==='wallet');
document.getElementById('tabP').classList.toggle('on',t==='pays');
document.getElementById('tabR').classList.toggle('on',t==='profil');
if(t==='pays')updateDepts();
}
function toggleSolde(){soldeVisible=!soldeVisible;localStorage.setItem('solde_visible',soldeVisible?'yes':'no');refreshSolde();}
function refreshSolde(){document.getElementById('soldeTxt').innerText=soldeVisible?solde.toLocaleString('fr-FR')+' FCFA':'••••• FCFA';document.getElementById('eyeBtn').innerText=soldeVisible?'👁️':'🙈';}
function saveProfile(){localStorage.setItem('profName',document.getElementById('profName').value);localStorage.setItem('profPhone',document.getElementById('profPhone').value);localStorage.setItem('profVillage',document.getElementById('profVillage').value);currentLoc.village=document.getElementById('profVillage').value||currentLoc.village;localStorage.setItem('currentLoc',JSON.stringify(currentLoc));alert('Profil sauvé: '+currentLoc.village);updateLocPill();switchTab('wallet');}
function initPiSdk(){try{Pi.init({version:"2.0",sandbox:false});piReady=true;document.getElementById('piStatus').innerText="● Pi SDK: Prêt";let saved=localStorage.getItem('pi_user_v27');if(saved){piUser=JSON.parse(saved);updatePiUI();}}catch(e){document.getElementById('piStatus').innerText="● Pi: Ouvre dans Pi Browser";piReady=false;}}
function connectPi(){if(!piReady){alert("Ouvre dans Pi Browser");return;}document.getElementById('btnPi').innerText="Connexion...";Pi.authenticate(['username','payments','wallet_address'],()=>{}).then(auth=>{piUser=auth.user;localStorage.setItem('pi_user_v27',JSON.stringify(auth));updatePiUI();alert("Pi Connecté: "+auth.user.username);}).catch(err=>{document.getElementById('btnPi').innerText="Réessayer Pi";alert("Erreur Pi");});}
function updatePiUI(){if(piUser){document.getElementById('piStatus').innerText="● Pi: Connecté ✓ "+(piUser.username||"");document.getElementById('piDetail').innerHTML=`<b>Pi:</b> ${piUser.username}<br><b>Village:</b> ${currentLoc.village}<br><b>Valid:</b> OK`;document.getElementById('btnPi').innerText="✓ Pi: "+(piUser.username||"");updateLocPill();}}
function refresh(){refreshSolde();localStorage.setItem('sal_v27_solde',solde);load();}
function openS(n){
cur=n;document.getElementById('mTitle').innerText=n;
let desc="";let showInterop=false;let showFacture=false;
if(['Salima','NITA','Amana'].includes(n)){desc=`Transfert ${n} → vers autre réseau`;showInterop=true;}
else if(['Airtel Money','Moov Money','Zamani'].includes(n)){desc=`Mobile Money ${n} - ${currentLoc.village}`;}
else if(n==='NIGELEC'){desc=`Facture Électricité NIGELEC - ${currentLoc.region}`;showFacture=true;document.getElementById('factureLabel').innerText="Réf compteur NIGELEC";}
else if(n==='SEEN'){desc=`Facture Eau SEEN - ${currentLoc.village}`;showFacture=true;document.getElementById('factureLabel').innerText="Réf abonné SEEN";}
else if(n==='Encaisser'){desc=`Dépôt à ${currentLoc.village}`;}
document.getElementById('mDesc').innerText=desc;
document.getElementById('fieldInterop').style.display=showInterop?'block':'none';
document.getElementById('fieldFacture').style.display=showFacture?'block':'none';
document.getElementById('modal').classList.add('on');
}
function closeM(){document.getElementById('modal').classList.remove('on');}
document.getElementById('mont').addEventListener('input',()=>{
let m=parseInt(document.getElementById('mont').value)||0;let f=Math.round(m*0.2);
document.getElementById('calc').innerHTML=m?`Montant: ${m.toLocaleString()} F | Bénéf 20%: <b style="color:#7ab800">${f.toLocaleString()} F</b> | Village: ${currentLoc.village}<br>Total client: ${(m+f).toLocaleString()} F`:'';
});
function doTrans(){
let num=document.getElementById('num').value.trim();let m=parseInt(document.getElementById('mont').value);
if(!num||!m)return alert('Numéro + Montant');
if(cur!=='Encaisser'&&m>solde)return alert('Solde insuffisant: '+solde);
let interop=document.getElementById('interopSel').value;let factureRef=document.getElementById('factureRef').value.trim();
let fee=Math.round(m*0.2);let total=m+fee;let id='SLM-'+Math.floor(1000000+Math.random()*8999999);
if(cur==='Encaisser'){solde+=m;fee=0;total=m;}else{solde-=total;}
let village=document.getElementById('mVillageSel').value||currentLoc.village;
let rec={id:id,service:cur,from:cur,to:interop||cur,phone:num,amount:m,fee:fee,total:total,village:village,region:currentLoc.region,pays:currentLoc.pays,facture:factureRef,date:new Date().toLocaleString('fr-FR'),pi:piUser?piUser.username:'Sans Pi',benef:cur==='Encaisser'?0:fee};
let arr=JSON.parse(localStorage.getItem('sal_v27_recus')||'[]');arr.unshift(rec);localStorage.setItem('sal_v27_recus',JSON.stringify(arr));
refresh();closeM();showReceipt(rec);
}
let selectedRec=null;
function showReceipt(r){
selectedRec=r;
let html=`<b style="color:#4ade80">${r.id} - ${r.service} ${r.from!==r.to?'→ '+r.to:''}</b><br>
${r.service==='NIGELEC'?'⚡ Électricité NIGELEC':r.service==='SEEN'?'💧 Eau SEEN':r.service}<br>
<div class="row"><span>Village</span><span>${r.village} - ${r.region}</span></div>
<div class="row"><span>Pays</span><span>${r.pays}</span></div>
<div class="row"><span>Numéro / Réf</span><span>${r.phone} ${r.facture?'('+r.facture+')':''}</span></div>
<div class="row"><span>Montant</span><span>${r.amount.toLocaleString()} FCFA</span></div>
<div class="row"><span>Frais 20%</span><span>${r.fee.toLocaleString()} FCFA</span></div>
<div class="totalRow"><span>Total</span><span>${r.total.toLocaleString()} FCFA</span></div>
<div class="row"><span>Date</span><span>${r.date}</span></div>
<div class="row"><span>Pi</span><span>${r.pi}</span></div>`;
document.getElementById('rDetail').innerHTML=html;
document.getElementById('rSub').innerText=`${r.village} • ${r.service} → ${r.to}`;
document.getElementById('receiptView').classList.add('on');
}
function load(){
let arr=JSON.parse(localStorage.getItem('sal_v27_recus')||'[]');
document.getElementById('nbT').innerText=arr.length+' transac';
let benef=arr.reduce((a,b)=>a+(b.benef||0),0);
document.getElementById('revPill').innerText=benef.toLocaleString()+' F bénéf';
let listDiv=document.getElementById('list');
if(!arr.length){listDiv.innerHTML='<small style="opacity:.5">Aucun reçu - fais un transfert</small>';return;}
listDiv.innerHTML=arr.map((r,i)=>`<div style="background:#1a1a1a;padding:10px;border-radius:10px;margin:6px 0;font-size:12px;display:flex;justify-content:space-between" onclick="showReceiptByIndex(${i})"><span>${r.service}${r.from!==r.to?'→'+r.to:''} - ${r.amount}F - ${r.village}</span><span style="color:#7ab800">Voir</span></div>`).join('');
}
function showReceiptByIndex(i){let arr=JSON.parse(localStorage.getItem('sal_v27_recus')||'[]');showReceipt(arr[i]);}
window.addEventListener('load', init);
</script></body></html>
